    "+zen-browser.app.css": {
      "zen-transparency": ":root {\n  --light: transparent !important;\n}\nhtml, body, nav, #nav, .nav, navbar, .navbar, #navbar header, #header, .header, app, #app, .app, .app-root, #pass-sidebar, #main, main, .page .center, .overflow::after, .astronav-items, #content, section, #__next, #navigation-wrapper, #global-navbar, #nd-sidebar, .head.notfixed, body.dark_mode, body.light_mode {\n  background-color: transparent !important;\n  background: none !important;\n  border: none !important;\n  box-shadow: none !important;\n  transition:\n    background-color 0.5s ease-in-out,\n    background 0.5s ease-in-out,\n    border 0.5s ease-in-out,\n    box-shadow 0.5s ease-in-out !important;\n}",
      "footer": "#footer {\n  background-color: color-mix(in srgb, var(--zen-dark), transparent) !important;\n  transition:\n    background-color 0.5s ease-in-out,\n    background 0.5s ease-in-out,\n    border 0.5s ease-in-out,\n    box-shadow 0.5s ease-in-out !important;\n  border: none !important;\n}",
      "popups-fix": "#customization-panel, .panel-arrowcontent, panelmultiview, menupopup, .thunderbird-popup, #appMenu-popup, #customization-panel-container {\n  background-color: #1e1e1e !important;\n  background-image: none !important;\n  border: 1px solid #333333 !important;\n}\n.panel-arrowcontent *, menupopup * {\n  color: #ffffff !important;\n}"
